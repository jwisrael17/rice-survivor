rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function commissioner(leagueCode) {
      return signedIn()
        && get(/databases/$(database)/documents/leagues/$(leagueCode)).data.commissionerUid == request.auth.uid;
    }

    function siteAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }

    match /leagues/{leagueCode} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.commissionerUid == request.auth.uid;
      allow update, delete: if commissioner(leagueCode) || siteAdmin();

      match /members/{memberId} {
        allow read: if true;
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.points == 0;
        allow update: if commissioner(leagueCode) || siteAdmin()
          || (signedIn()
            && memberId == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.points == resource.data.points);
        allow delete: if commissioner(leagueCode) || siteAdmin()
          || (signedIn() && memberId == request.auth.uid);
      }
    }

    match /users/{userId}/leagues/{leagueCode} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /tribalResults/{resultId} {
      allow read: if true;
      allow create, update, delete: if siteAdmin();
    }

    match /adminSessions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /adminAttempts/{userId} {
      allow read, write: if false;
    }
  }
}
